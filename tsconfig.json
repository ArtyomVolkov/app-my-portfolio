{
  "compileOnSave": false,
  "sourceMap": true,
  "noImplicitAny": true,
  "include": ["./src", "webpack.config.ts", "server.js", "types"],
  "exclude": ["node_modules", "build", "server.js", "src/service-worker.js"],
  "compilerOptions": {
    "typeRoots": ["node_modules/@types", "src/types"],
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ESNext",
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "allowJs": true,
    "baseUrl": "src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "paths": {
      "*": ["src/*"],
      "@assets/*": ["assets/*"],
      "@api/*": ["api/*"],
      "@app/*": ["app/*"],
      "@pages/*": ["app/pages/*"],
      "@store/*": ["app/store/*"],
      "@config/*": ["config/*"],
      "@constants/*": ["constants/*"],
      "@components/*": ["components/*"],
      "@services/*": ["services/*"],
      "@shared/*": ["shared/*"],
      "@utils/*": ["utils/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable"]
  }
}
